# Copy to `.env` in this directory for docker-compose (backend reads the same file when mounted).
# Never commit real secrets.

OPENAI_API_KEY=
# Azure Speech: no spaces/BOM around key or region (backend strips zero-width chars automatically)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Allow edge-tts/gTTS when Azure fails (401, rate limits, etc.)
TTS_DISABLE_NON_AZURE_FALLBACK=false
# edge = try Microsoft Edge online TTS first (no Azure key). azure = Azure first when configured.
TTS_PRIMARY_PROVIDER=edge

# Phase A — JWT for Cogni login (set a long random string in production)
JWT_SECRET=change_this_in_production

# Optional: comma- or space-separated extra CORS origins
# EXTRA_ORIGINS=https://your-app.example.com

# Phase C — Redis (horizontal scale / Cogni shared state)
REDIS_URL=redis://localhost:6379/0

# DB pool (SQLAlchemy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Rate limits & cost (optional)
OPENAI_TOKEN_LIMIT_PER_MINUTE=5000
TTS_CALL_LIMIT_PER_HOUR=30
OPENAI_COST_PER_1K_TOKENS=0.005
AZURE_TTS_COST_PER_1K_CHARS=0.015

# Model tiers (tutor)
TUTOR_MODEL=gpt-4o
TUTOR_MODEL_FREE=gpt-4o-mini

# BTEC local RAG — corpus files live in ./backend/data/btec-bus (mounted to /app/btec_corpus in Docker)
LOCAL_RAG_ENABLED=true
LOCAL_RAG_DIR=/app/btec_corpus
# Chroma collection btec_knowledge_base (backend/scripts/btec_ingest.py) — tutor RAG
BTEC_CHROMA_RAG_ENABLED=true
# BTEC_CHROMA_RAG_TOP_K=4
# LOCAL_RAG_CHUNK_SIZE=600
# LOCAL_RAG_MAX_FILES=80

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SAML / Azure AD SSO (optional)
# SAML_IDP_SSO_URL=https://login.microsoftonline.com/.../saml2

# ── V28 Digital Human (feature flags) ─────────────────────────────────────────
# ENABLE_CAMERA_FEED=true
# ENABLE_DEVICE_CONTEXT=true
# ENABLE_THEORY_OF_MIND=true
# ENABLE_EMOTIONAL_CONTAGION=true
# ENABLE_ACTIVE_EMPATHY=true
# ENABLE_PERSONA_LEARNING=true
# ENABLE_YEARLY_MEMORY=true
# ENABLE_SESSION_TIMELINE=true
# ENABLE_POST_SESSION_REFLECTION=true
# ENABLE_TRAINING_DATA=true
# ENABLE_RL_POLICY=false
# ENABLE_REDIS_SESSION_SYNC=true
# ENABLE_ETHICAL_FILTER=true
# ENABLE_LAYERED_TTS=false

# Jordanian Arabic TTS (Azure Neural) — must match docker-compose overrides for Cogni
TTS_ARABIC_VOICE=ar-JO-TaimNeural
COGNI_ARABIC_TTS_VOICE_LOCKED=ar-JO-TaimNeural

# BTEC tutorial DB + scaffolding (recommended on for full digital-human tutor)
ENABLE_TUTORIAL_PERSISTENCE=true
COGNI_AUTO_BTEC_SCAFFOLDING=true
# COGNI_PEDAGOGICAL_PERFORMANCE=true
# COGNI_STAGE_GESTURES=true

# Frontend — optional VRM override (otherwise cogni-avatar.vrm chain in avatar.ts)
# NEXT_PUBLIC_AVATAR_VRM_URL=/models/cogni-avatar.vrm
# NEXT_PUBLIC_AVATAR_STAND_Y_OFFSET=0
# Carpet logical floor = carpet AABB max.y + this (metres). Default in code 0.10 if unset.
# Measure gap in dev (console snippet in AvatarCanvas JSDoc): e.g. ~0.15 m feet above floor → try 0.15–0.21.
# NEXT_PUBLIC_RUG_WALK_SURFACE_Y_EXTRA=0.10
# NEXT_PUBLIC_AVATAR_SIT_Y_OFFSET=0
# NEXT_PUBLIC_AVATAR_FACING_YAW_BASE=
