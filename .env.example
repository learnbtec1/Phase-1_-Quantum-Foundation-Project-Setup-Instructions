# Copy to `.env` in this directory for docker-compose (backend reads the same file when mounted).
# Never commit real secrets.
#
# ── Canonical dev ports (keep every client aligned) ─────────────────────────
# • Next.js (browser): http://127.0.0.1:3000  — frontend `npm run dev` or Compose `frontend` publishes 3000:3000.
# • FastAPI + `/ws/agent`: http://127.0.0.1:8000 — Compose `backend` publishes 8000:8000.
# • Optional kinematic WS (NOT Cogni agent): ws://127.0.0.1:8011 (`avatar_brain` in compose).
# • Optional Chroma (`--profile chroma`): http://127.0.0.1:8010.

# Optional: canonical browser origin for OG / absolute URLs (Compose + local dev use port 3000).
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# ── LLM (tutor, RAG embeddings, grading) — required for full Cognitive layer in Docker/backend
OPENAI_API_KEY=

# ── TTS — Local-first (Piper via docker-compose `local_tts_*`; no API keys required)
NEXT_PUBLIC_TTS_PROVIDER=local
TTS_PROVIDER=local
# Optional: multi-instance pool matches compose alias `local_tts` + `local_tts_2`
# LOCAL_TTS_URLS=http://local_tts:8080/synthesize,http://local_tts_2:8080/synthesize
# LOCAL_TTS_URL=http://local_tts:8080/synthesize
# TTS_FALLBACK_CHAIN=local_piper

# ── ElevenLabs (optional — only if you set NEXT_PUBLIC_TTS_PROVIDER=elevenlabs and add keys)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Browser (runs on YOUR machine — not inside frontend container): FastAPI publishes :8000, avatar kinematic WS :8011
# NEXT_PUBLIC_WS_URL overrides NEXT_PUBLIC_AGENT_WS — do NOT point /ws/agent at port 8001/8011 (that is avatar_brain, not the agent).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AGENT_WS=ws://127.0.0.1:8000/ws/agent
# Optional mirror (when set alone, derives WS from NEXT_PUBLIC_API_URL):
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/agent
# Generative VRMA kinematic service (Compose maps host 8011 → avatar_brain) — unrelated to NEXT_PUBLIC_WS_URL agent path.
NEXT_PUBLIC_GENERATIVE_GESTURE_WS=ws://127.0.0.1:8011

# Do not fall back to Edge after ElevenLabs failure (only relevant if you use elevenlabs in chain)
# TTS_EDGE_FALLBACK_AFTER_ELEVENLABS=false

# Local-only: if your network can use free Edge TTS, set both to edge and omit EL keys (not recommended on VPS)
# NEXT_PUBLIC_TTS_PROVIDER=edge
# TTS_PROVIDER=edge
# صوت العربية أنثوي Microsoft Edge Neural (Zariyah — ar-SA-ZariyahNeural)
EDGE_TTS_VOICE=ar-SA-ZariyahNeural
TTS_ARABIC_VOICE=ar-SA-ZariyahNeural
COGNI_ARABIC_TTS_VOICE_LOCKED=ar-SA-ZariyahNeural
# Azure Speech: no spaces/BOM around key or region (backend strips zero-width chars automatically)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# false = allow non-Azure fallbacks when Azure-only is off (local dev). Docker compose sets this per service.
TTS_DISABLE_NON_AZURE_FALLBACK=false
# edge = Edge TTS first (no cloud key). azure = Azure Speech when AZURE_SPEECH_KEY is set.
TTS_PRIMARY_PROVIDER=edge

# Phase A — JWT for Cogni login (docker-compose requires this variable to be set)
# Use a long random string before production (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_in_production

# Postgres (docker-compose `db` + backend DATABASE_URL). Defaults match dev; override for staging/prod.
# Avoid :, @, / in POSTGRES_PASSWORD or set DATABASE_URL manually for the backend.
POSTGRES_DB=eduverse
POSTGRES_USER=eduverse
POSTGRES_PASSWORD=eduverse

# Optional: comma- or space-separated extra CORS origins
# EXTRA_ORIGINS=https://your-app.example.com

# Production: restrict Host header (comma-separated, no scheme). Example: api.example.com,localhost
# ALLOWED_HOSTS=

# Phase C — Redis (horizontal scale / Cogni shared state)
# Compose maps Redis to host port 6380 (see docker-compose.yml) — use localhost:6380 only when the API runs on the host talking to Redis in Docker.
REDIS_URL=redis://localhost:6380/0

# DB pool (SQLAlchemy)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Rate limits & cost (optional)
OPENAI_TOKEN_LIMIT_PER_MINUTE=5000
TTS_CALL_LIMIT_PER_HOUR=30
OPENAI_COST_PER_1K_TOKENS=0.005
AZURE_TTS_COST_PER_1K_CHARS=0.015

# Model tiers (tutor)
TUTOR_MODEL=gpt-4o
TUTOR_MODEL_FREE=gpt-4o-mini
# BTEC forensic grading (`app/archive/forensic_engine.py`) — override with claude-* if using Anthropic
GRADER_MODEL=gpt-5

# BTEC local RAG — corpus files live in ./backend/data/btec-bus (mounted to /app/btec_corpus in Docker)
LOCAL_RAG_ENABLED=true
LOCAL_RAG_DIR=/app/btec_corpus
# Chroma collection btec_knowledge_base (backend/scripts/btec_ingest.py) — tutor RAG
BTEC_CHROMA_RAG_ENABLED=true
# After setting OPENAI_API_KEY, ingest PDFs into Chroma (one-shot):
#   docker compose --profile ingest run --rm btec-ingest
# BTEC_CHROMA_RAG_TOP_K=4
# LOCAL_RAG_CHUNK_SIZE=600
# LOCAL_RAG_MAX_FILES=80

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SAML / Azure AD SSO (optional)
# SAML_IDP_SSO_URL=https://login.microsoftonline.com/.../saml2

# ── V28 Digital Human (feature flags) ─────────────────────────────────────────
# ENABLE_CAMERA_FEED=true
# ENABLE_DEVICE_CONTEXT=true
# ENABLE_THEORY_OF_MIND=true
# ENABLE_EMOTIONAL_CONTAGION=true
# ENABLE_ACTIVE_EMPATHY=true
# ENABLE_PERSONA_LEARNING=true
# ENABLE_YEARLY_MEMORY=true
# ENABLE_SESSION_TIMELINE=true
# ENABLE_POST_SESSION_REFLECTION=true
# ENABLE_TRAINING_DATA=true
# ENABLE_RL_POLICY=false
# ENABLE_REDIS_SESSION_SYNC=true
# ENABLE_ETHICAL_FILTER=true
# ENABLE_LAYERED_TTS=false

# V44 — BTEC tutorial DB + scaffolding gestures (backend also reads these when set in compose)
# ENABLE_TUTORIAL_PERSISTENCE=true
# COGNI_AUTO_BTEC_SCAFFOLDING=true
# COGNI_PEDAGOGICAL_PERFORMANCE=true
# COGNI_STAGE_GESTURES=true
