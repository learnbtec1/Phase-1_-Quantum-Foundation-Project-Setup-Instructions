# EDUVERS-CORE — copy to .env and fill secrets (no TTS/avatar/3D variables)
#
# Docker Compose host port mappings (required for `docker compose up` from repo root).
# Container names: eduvor-backend, eduvor-db, eduvor-redis, eduvor-frontend (not eduverse_backend).
# If you change EDUVOR_API_PORT, run: docker compose build --no-cache frontend
#
EDUVOR_DB_PORT=5433
EDUVOR_API_PORT=8001
EDUVOR_UI_PORT=3001
#
# --- Frontend → Backend (Next.js, baked at build; must match your API host port) ---
# Origin ONLY — do NOT add /api/v1 here; the app calls `${NEXT_PUBLIC_API_URL}/api/v1/...`
# With EDUVOR_API_PORT=8001, use (see also frontend/.env.example):
# NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
#
# Compose passes NEXT_PUBLIC_* as Dockerfile ARG for ``frontend``.
# Prefer one source: ``docker compose --env-file ./frontend/.env build --no-cache frontend`` (same vars as ``env_file: ./frontend/.env``),
# or set matching values in this root ``.env`` (otherwise Compose uses defaults matching EDUVOR_API_PORT below).
# Optional bake-time TTS switches (default: Edge BFF `/api/tts-with-timing`; optional NEXT_PUBLIC_USE_WS_AGENT_AUDIO): NEXT_PUBLIC_TTS_PROVIDER, NEXT_PUBLIC_DEBUG_TTS.
# Explicit WS URL avoids silent http vs ws mismatches:
# NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/agent
# Temporary diagnostics: neural BFF skipped in browser — use ``false`` for normal behavior.
# NEXT_PUBLIC_DEBUG_FORCE_WEB_SPEECH_TTS=false
#
# The Next.js app rewrites /api/v1 to this URL so the browser does not need cross-origin CORS to the API.
#
# Text-only UI: keep false. Set true only if you add an avatar/3D layer later.
NEXT_PUBLIC_USE_AVATAR=false

# --- OpenAI (text only) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Seconds: hard cap per embeddings.create (vector search/ingest)
# OPENAI_EMBED_TIMEOUT_SECONDS=8
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_ASSESSMENT_MODEL=gpt-4o-mini
# Optional: Google Generative Language (Gemini) — AI BTEC Decoder: P/M/D ladder from assignment brief PDF
# GOOGLE_API_KEY=
# Optional dedicated key for Ultra Tutor (else GOOGLE_API_KEY is used)
# GEMINI_API_KEY=
# GEMINI_ASSIGNMENT_BRIEF_MODEL=gemini-2.0-flash
# GEMINI_ULTRA_MODEL=gemini-1.5-pro
# (alias: GEMINI_BRIEF_MODEL, GOOGLE_GEMINI_MODEL)
# Optional: model for "guided example" rewrite (Pass→Merit, Merit→Distinction); same default as assessment is fine
OPENAI_REWRITE_MODEL=gpt-4o-mini
# STUDENT_REWRITE_ENABLED=true
# FEATURE_ALLOW_AI_REWRITE=true
# STUDENT_REWRITE_MAX_CHARS=12000
# STUDENT_REWRITE_SIMILARITY_FLOOR=0.7
# Optional: set false to skip global/subject style priors in guided rewrite (grading unchanged)
# TEACHER_MEMORY_ENABLED=true
# Global memory: use pattern only if weight = min(1, count / divisor) >= this floor
# TEACHER_MEMORY_MIN_WEIGHT=0.4
# TEACHER_MEMORY_WEIGHT_COUNT_DIVISOR=20
# TEACHER_MEMORY_BLEND_GLOBAL=0.4
# TEACHER_MEMORY_BLEND_SUBJECT=0.6
# TEACHER_MEMORY_MAX_PATTERN_WEIGHT=0.85
# TEACHER_MEMORY_TIME_DECAY_PER_30D=0.98
# Set to 1.0 to disable shrinking all rows on each quality-approved teacher edit
# TEACHER_MEMORY_DECAY_ON_VALID_SAVE=1.0
# TEACHER_EDIT_MIN_SIMILARITY=0.5

# Optional: use DB-learned linear weights (after POST /api/v1/integrity/retrain; needs training rows)
# INTEGRITY_USE_LEARNED_WEIGHTS=false
# INTEGRITY_RETRAIN_MIN_SAMPLES=8

# --- PostgreSQL (local / Docker) ---
# Compose uses image pgvector/pgvector:pg15 so the `vector` type/extension works (RAG + /vectors/search).
# If you use plain postgres:15, run once inside DB: CREATE EXTENSION IF NOT EXISTS vector;
#   docker exec -it eduvor-db psql -U eduvor -d eduvor_core -c "CREATE EXTENSION IF NOT EXISTS vector;"
POSTGRES_USER=eduvor
POSTGRES_PASSWORD=eduvor_dev_change_me
POSTGRES_DB=eduvor_core
# Optional: db-backup service dumps to volume `backups_data` (./scripts/pg_backup.sh). Keeps last 7 daily .sql files.
# Host-only tools (DBeaver, psql): must match POSTGRES_* and EDUVOR_DB_PORT above (5433 → localhost:5433).
# The FastAPI container reads DATABASE_URL from ./backend/.env (hostname `db`, port 5432) — not this line.
DATABASE_URL=postgresql://eduvor:eduvor_dev_change_me@localhost:5433/eduvor_core

# --- JWT (auth) ---
JWT_SECRET_KEY=change_me_use_a_long_random_string
JWT_ALGORITHM=HS256
# HttpOnly session cookie name (must match frontend middleware). Set True behind HTTPS in production.
# AUTH_COOKIE_NAME=eduvor_token
# AUTH_COOKIE_SECURE=true
ACCESS_TOKEN_EXPIRE_MINUTES=60

# تطابق التطوير المحلي: انسخ قيم AUTH_DEV_* من backend/.env.example إلى backend/.env؛
# وفي frontend/.env ضع NEXT_PUBLIC_DEV_TOKEN (أو LEGACY NEXT_PUBLIC_DEV_AUTH_TOKEN) نفس قيمة AUTH_DEV_STATIC_TOKEN.
# لا تُفعَّل في الإنتاج.
# AUTH_DEV_BYPASS=true
# AUTH_DEV_STATIC_TOKEN=test-token-123
# AUTH_DEV_STATIC_USER_ID=1

ENABLE_REGISTRATION=true

# Login requires verified email when True (default). Set false only to unblock accounts stuck without mail (staging/recovery).
# New sign-ups are auto-verified when MAIL_USERNAME/MAIL_PASSWORD are unset (no outbound SMTP).
# REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=true

# Public URL of the Next.js app (reset-password links, verify-email redirect). Must match EDUVOR_UI_PORT host mapping.
FRONTEND_URL=http://localhost:3001
# Public URL of this FastAPI (must match the port you expose; used in **verification** emails as the CTA target:
#   {BACKEND_PUBLIC_URL}/api/v1/auth/verify-email?token=...
# The API verifies then 302-redirects to FRONTEND_URL/verify-email?verified=1
BACKEND_PUBLIC_URL=http://localhost:8001

# --- Mailtrap Email Sandbox (fastapi-mail) — paste Username/Password from Inbox → SMTP settings ---
# MAIL_USERNAME=your_mailtrap_username
# MAIL_PASSWORD=your_mailtrap_password
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_FROM=support@eduversejo.com
# MAIL_FROM_NAME=EduVerse
# (Optional) Legacy fallbacks for password reset if the MAIL_* block is empty:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=support@eduversejo.com

# Stripe: subscribe & invoices (optional — leave empty to disable /billing checkout)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2023-10-16
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_ADVANCED=price_...
# Pro monthly (alias: STRIPE_PRICE_ID_PRO)
# STRIPE_PRICE_PRO=price_...
# Unlimited monthly
# STRIPE_PRICE_ID_UNLIMITED=price_...

# Password reset over SMTP (optional — if unset, reset URL is logged by the API for dev)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Sentry (optional)
# SENTRY_DSN=

# --- Optional (defaults are fine) ---
# CORS: optional extra origins; main.py always merges in localhost/127.0.0.1 :3000/:3001/:3010
# (do not use * with credentialed frontends; explicit origins are merged, not replaced).
# BACKEND_CORS_ORIGINS=["http://localhost:3001","http://127.0.0.1:3001","http://localhost:3010"]
# ASSESSMENT_RETRIEVAL_TOP_K=8
# ASSESSMENT_MAX_CONTEXT_CHARS=12000
# RAG ref token trim (student work never trimmed here). See config.py ASSESSMENT_RAG_REF_*.
# ASSESSMENT_RAG_REF_CONTEXT_FRACTION=0.62
# ASSESSMENT_RAG_REF_PER_BLOCK_MAX_CHARS=3200
# Two-stage grader: sticky bucket 0-99 < ROLLOUT_PERCENT; FORCE_* overrides; persisted A/B JSON in backend data/.
# ASSESSMENT_GRADER_SPLIT_ENABLED=false
# ASSESSMENT_GRADER_SPLIT_ROLLOUT_PERCENT=10
# ASSESSMENT_GRADER_FORCE_SINGLE_MODE=false
# ASSESSMENT_GRADER_FORCE_SPLIT_MODE=false
# Auto rollout: adjusts effective split % from A/B (Redis/JSON); never 100; respects FORCE_*. default off.
# AUTO_ROLLOUT_ENABLED=false
# AUTO_ROLLOUT_MIN_SAMPLES=50
# AUTO_ROLLOUT_MAX_ROLLOUT_PERCENT=80
# AUTO_ROLLOUT_STEP_UP=10
# AUTO_ROLLOUT_STEP_DOWN=10
# AUTO_ROLLOUT_COOLDOWN_SECONDS=600
# AUTO_ROLLOUT_MAX_MISMATCH_PCT=5
# AUTO_ROLLOUT_MIN_CONF_DELTA=-0.02
# AUTO_ROLLOUT_STATE_PATH=data/auto_rollout_state.json
# A/B: async shadow (non-blocking) subsampled; never counts toward user-facing grade latency.
# ASSESSMENT_AB_TRACKING_ENABLED=false
# ASSESSMENT_AB_MAX_SHADOW_PERCENT=5
# ASSESSMENT_AB_SHADOW_MAX_PER_MINUTE=30
# ASSESSMENT_AB_STORE_PATH=data/grader_ab_store.json
# ASSESSMENT_AB_STORE_MAX_SAMPLES=1000
# ASSESSMENT_AB_READINESS_MIN_SAMPLES=0
# ASSESSMENT_AB_MIN_SAMPLES_FOR_RECOMMENDATION=20
# ASSESSMENT_AB_MAX_MISMATCH_PCT=5.0
# PASS0 disk cache max age (seconds). ASSESSMENT_PASS0_DISK_TTL_SECONDS=3600
# Query embedding cache (vector search): ASSESSMENT_QUERY_EMBED_CACHE_TTL_SECONDS=3600
# ASSESSMENT_QUERY_EMBED_CACHE_MAX_ENTRIES=500
# Multi-step pipeline: cap chunk count and minimum student work (words) for chunk/RAG steps.
# ASSESSMENT_PIPELINE_MAX_CHUNKS=50
# ASSESSMENT_MIN_WORDS=150
# Replay identical per-criterion results from RAM (disable for dev: always recompute).
# ASSESSMENT_EVAL_CACHE_ENABLED=true
# ASSESSMENT_EVAL_CACHE_MAX_ENTRIES=2000
# L2 / rate limits / A/B (same variable via alias: REDIS_URL or ASSESSMENT_REDIS_URL).
# --- In Docker: backend must reach the `redis` service by name (NOT localhost). Example:
# REDIS_URL=redis://redis:6379/0
# --- Running API on the host (uvicorn) with `ports: 6379:6379` published:
# REDIS_URL=redis://127.0.0.1:6379/0
# # ASSESSMENT_REDIS_URL=redis://localhost:6379/0
#
# --- VPS + Caddy (backend/docker-compose.yml, profile caddy) ---
# docker compose --profile caddy up -d --build  (from backend/ with CADDY_DOMAIN set for real TLS)
# CADDY_DOMAIN=api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# BACKEND_PUBLIC_URL=https://api.yourdomain.com
# AUTH_COOKIE_SECURE=true
# BACKEND_CORS_ORIGINS=["https://yourdomain.com"]
# Vercel → Environment: NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# A/B grader metrics: use Redis for atomic counters, or set false to keep JSON only.
# ASSESSMENT_AB_USE_REDIS=true
# One-time: if hash empty and JSON has old rows, HSET to Redis and set grader_ab_migrated (SETNX lock).
# ASSESSMENT_AB_MIGRATE_JSON_TO_REDIS=true
# ASSESSMENT_REDIS_TTL_SECONDS=604800
# ASSESSMENT_REDIS_KEY_PREFIX=eduvor:assessment
