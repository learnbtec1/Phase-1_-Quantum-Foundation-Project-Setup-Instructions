{
  "name": "eduverse-platform-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-azure-speech-browser-bundle.mjs",
    "clean:port": "npx kill-port 3000",
    "dev": "next dev -H 0.0.0.0 -p 3000 --webpack",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:ui": "playwright test -c playwright.ui.config.ts --headed --project=chromium --reporter=list",
    "playwright:install": "playwright install chromium --with-deps",
    "audit": "npm audit --audit-level=high",
    "test:ws-url": "node --experimental-strip-types --test src/lib/wsAgentUrl.test.ts",
    "test:brain": "tsx --test src/store/useBrainStore.brain.test.ts",
    "test:normalize": "node --experimental-strip-types --test src/utils/events/__tests__/normalizeAvatarEvents.test.ts",
    "test:unit": "npm run test:ws-url && npm run test:brain && npm run test:normalize",
    "test:integration": "tsx --test src/integration/brainMotionPipeline.integration.test.ts",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test"
  },
