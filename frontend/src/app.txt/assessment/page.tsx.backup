'use client';

import { useMemo, useRef, useState, useCallback, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import {
  Shield, FileUp, Brain, CheckCircle, Loader2, XCircle,
  Trash2, FileText, Book, Plus, Layers, Layout, ChevronDown, Info, Presentation, FileSearch
} from 'lucide-react';
import { toast, Toaster } from 'react-hot-toast';
import * as mammoth from 'mammoth';

// Academic data structure
const ACADEMIC_DATA: Record<string, Record<string, string[]>> = {
  "عاشر": {
    "فصل أول": ["الغرض من إنشاء شركة", "مؤسسات الأعمال", "التنبؤ", "خطة التسويق"],
    "فصل ثاني": ["وحدة 15: إنشاء شركة صغيرة", "وحدة 16: ضمن فريق", "وحدة 17: إدارة الشؤون المالية", "وحدة 19: الترويج البصري"],
    "فصل ثالث": ["وحدة 11: الشركات عبر الإنترنت", "وحدة 13: أخلاقيات الأعمال", "وحدة 28: إدارة الشركة", "وحدة 5: الموظفون"]
  },
  "أول ثانوي": {
    "فصل أول": ["حملة إطلاق منتج جديد"],
    "فصل ثاني": ["استكشاف الأعمال 2", "التمويل - الجزء 1"],
    "فصل ثالث": ["إدارة الفعاليات", "التمويل - الجزء 2"]
  },
  "توجيهي": {
    "فصل أول": ["اتخاذ قرارات الأعمال", "الموارد البشرية - الجزء 1"],
    "فصل ثاني": ["مبادئ إدارة الأعمال", "خدمة العملاء", "الموارد البشرية - الجزء 2"],
    "فصل ثالث": ["أخلاقيات الأعمال"]
  }
};

// Type declaration for window.pdfjsLib loaded from CDN
declare global {
  interface Window {
    pdfjsLib?: any;
  }
}

function initPdfJsFromCDN() {
  if (typeof window === 'undefined') return;
  if (window.pdfjsLib) return;

  const script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
  script.async = true;
  script.onload = () => {
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  };
  script.onerror = () => {
    console.warn('Failed to load PDF.js from CDN');
  };
  document.head.appendChild(script);
}

let __jszipOnce__: Promise<any> | null = null;
async function getJsZip() {
  if (!__jszipOnce__) __jszipOnce__ = import('jszip');
  return __jszipOnce__;
}

type UFile = { name: string; content: string; type: string; sizeMB: number };

const MAX_FILES = 20;
const MAX_MB_PER_FILE = 20;
const MAX_PDF_PAGES = 120;
const ACCEPT_EXTS = ['pdf', 'docx', 'pptx', 'txt'] as const;

const getExt = (name: string) => (name.split('.').pop() || '').toLowerCase();
const normalizeSpaces = (s: string) => s.replace(/\s+/g, ' ').trim();
const clampText = (s: string, max = 200_000) => (s.length > max ? s.slice(0, max) + '…' : s);

export default function AssessmentPage() {
  const [level, setLevel] = useState('');
  const [semester, setSemester] = useState('');
  const [subject, setSubject] = useState('');
  const [assignment, setAssignment] = useState<{ name: string; content: string } | null>(null);
  const [evidences, setEvidences] = useState<UFile[]>([]);
  const [isProcessing, setIsProcessing] = useState(false);
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [result, setResult] = useState<any>(null);
  const [expandedCode, setExpandedCode] = useState<string | null>(null);

  const assignmentRef = useRef<HTMLInputElement>(null);
  const evidencesRef = useRef<HTMLInputElement>(null);

  const stats = useMemo(() => ({
    evidCount: evidences.length,
    evidChars: evidences.reduce((a, f) => a + f.content.length, 0),
  }), [evidences]);

  useEffect(() => {
    initPdfJsFromCDN();
  }, []);

  const readPdf = useCallback(async (file: File) => {
    if (!window.pdfjsLib) {
      throw new Error('PDF library not available. Please use Word or text files.');
    }
    const pdfjs = window.pdfjsLib;
    const data = await file.arrayBuffer();
    const pdf = await pdfjs.getDocument({ data }).promise;
    const pages = Math.min(pdf.numPages, MAX_PDF_PAGES);
    let text = '';
    for (let i = 1; i <= pages; i++) {
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      text += content.items.map((it: any) => it.str).join(' ') + '\n';
    }
    return normalizeSpaces(text);
  }, []);

  const readDocx = useCallback(async (file: File) => {
    const buf = await file.arrayBuffer();
    const res = await mammoth.extractRawText({ arrayBuffer: buf });
    return normalizeSpaces(res.value || '');
  }, []);

  const readPptx = useCallback(async (file: File) => {
    const JSZip = await getJsZip();
    const zip = await JSZip.loadAsync(await file.arrayBuffer());
    let fullText = '';
    const slidePaths = Object.keys(zip.files).filter((n) => n.startsWith('ppt/slides/slide'));
    for (const p of slidePaths) {
      const xml = await zip.file(p)?.async('text');
      if (xml) {
        const matches = xml.match(/<a:t>([^<]+)<\/a:t>/g);
        if (matches) fullText += matches.map((m) => m.replace(/<\/?a:t>/g, '')).join(' ') + '\n';
      }
    }
    return normalizeSpaces(fullText);
  }, []);

  const readTxt = useCallback(async (file: File) => normalizeSpaces(await file.text()), []);

  const extractText = useCallback(async (file: File) => {
    const ext = getExt(file.name);
    if (ext === 'pdf') return readPdf(file);
    if (ext === 'docx') return readDocx(file);
    if (ext === 'pptx') return readPptx(file);
    if (ext === 'txt') return readTxt(file);
    throw new Error(`صيغة غير مدعومة: .${ext}`);
  }, [readPdf, readDocx, readPptx, readTxt]);

  const handleUpload = async (e: React.ChangeEvent<HTMLInputElement>, isAssignment: boolean) => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;

    setIsProcessing(true);
    const tid = toast.loading(isAssignment ? 'جاري قراءة ملف المهمة...' : 'جاري تحليل ملفات الطالب...');

    try {
      if (isAssignment) {
        const f = files[0];
        const ext = getExt(f.name);
        const sizeMB = +(f.size / (1024 * 1024)).toFixed(2);
        if (!ACCEPT_EXTS.includes(ext as any)) throw new Error(`صيغة غير مدعومة للمهمة: .${ext}`);
        if (sizeMB > MAX_MB_PER_FILE) throw new Error(`حجم المهمة أكبر من ${MAX_MB_PER_FILE}MB`);

        const content = clampText(await extractText(f));
        setAssignment({ name: f.name, content });
        setResult(null);
        toast.success('تم رفع ملف المهمة بنجاح', { id: tid });
      } else {
        const processed = await Promise.allSettled(
          files.map(async (f) => {
            const ext = getExt(f.name);
            const sizeMB = +(f.size / (1024 * 1024)).toFixed(2);
            if (!ACCEPT_EXTS.includes(ext as any)) throw new Error(`صيغة غير مدعومة: ${f.name}`);
            if (sizeMB > MAX_MB_PER_FILE) throw new Error(`الملف (${f.name}) يتجاوز ${MAX_MB_PER_FILE}MB`);
            if (evidences.some(ev => ev.name === f.name)) throw new Error(`تم تجاهل ملف مكرر: ${f.name}`);

            const content = clampText(await extractText(f));
            return { name: f.name, content, type: ext, sizeMB };
          })
        );

        const ok = processed.filter(r => r.status === 'fulfilled') as PromiseFulfilledResult<UFile>[];
        const bad = processed.filter(r => r.status === 'rejected') as PromiseRejectedResult[];

        const merged = [...evidences, ...ok.map(r => r.value)].slice(0, MAX_FILES);
        setEvidences(merged);
        setResult(null);

        if (ok.length) toast.success(`تمت إضافة ${ok.length} ملف/ملفات`, { id: tid });
        if (bad.length) bad.forEach((r) => toast.error((r.reason as Error)?.message || 'فشل قراءة ملف', { id: tid }));
      }
    } catch (err: any) {
      toast.error(err?.message || 'خطأ في القراءة', { id: tid });
    } finally {
      setIsProcessing(false);
      if (e.target) e.target.value = '';
    }
  };

  const handleEvaluate = async () => {
    if (!level || !semester || !subject) return toast.error('اختر المستوى والفصل والمادة أولًا');
    if (!assignment) return toast.error('ارفع ملف الواجب من بيرسون أولًا');
    if (!evidences.length) return toast.error('ارفع ملفات الطالب');

    setIsAnalyzing(true);
    setResult(null);

    const assignmentText = `BTEC Context
Level: ${level}
Semester: ${semester}
Subject: ${subject}

=== ASSIGNMENT BRIEF (from Pearson) ===
${assignment.content}`;

    const studentText = evidences.map(f => `\n[File: ${f.name}]\n${f.content}`).join('\n---\n');

    try {
      const res = await fetch('/api/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ assignmentText, studentText }),
      });

      const data = await res.json();
      if (data?.data) {
        setResult(data.data);
        toast.success('اكتمل التقييم الجنائي');
      } else {
        throw new Error(data?.error || 'فشل التقييم من الخادم');
      }
    } catch (err: any) {
      toast.error(err?.message || 'تعذر الاتصال بالخادم');
    } finally {
      setIsAnalyzing(false);
    }
  };

  return (
    <div className="min-h-screen bg-[#020205] text-white p-4 md:p-10 font-sans" dir="rtl">
      <Toaster position="top-center" />
      <div className="max-w-6xl mx-auto">

        <header className="text-center mb-12">
          <Shield className="w-16 h-16 text-cyan-400 mx-auto mb-4" />
          <h1 className="text-4xl font-black">المدقق الجنائي <span className="text-cyan-500">BTEC</span></h1>
          <p className="text-gray-400 mt-2">ارفع ملف الواجب من بيرسون ثم أدلة الطالب ليتم التقييم «حسب الواجب» وليس بشكل عام</p>
        </header>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
          {/* Selection Panel */}
          <div className="lg:col-span-1 space-y-4">
            <div className="bg-gradient-to-br from-purple-500/10 to-pink-500/10 border border-purple-500/20 rounded-2xl p-6">
              <h2 className="text-lg font-bold mb-4 flex items-center gap-2">
                <Layers className="w-5 h-5 text-purple-400" /> اختر السياق الأكاديمي
              </h2>

              <div className="space-y-3">
                <div>
                  <label className="text-xs font-semibold text-gray-300">المستوى</label>
                  <select value={level} onChange={(e) => { setLevel(e.target.value); setSemester(''); setSubject(''); }} className="w-full mt-1 bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm">
                    <option value="">-- اختر --</option>
                    {Object.keys(ACADEMIC_DATA).map(lv => <option key={lv} value={lv}>{lv}</option>)}
                  </select>
                </div>

                {level && (
                  <div>
                    <label className="text-xs font-semibold text-gray-300">الفصل</label>
                    <select value={semester} onChange={(e) => { setSemester(e.target.value); setSubject(''); }} className="w-full mt-1 bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm">
                      <option value="">-- اختر --</option>
                      {Object.keys(ACADEMIC_DATA[level] || {}).map(sem => <option key={sem} value={sem}>{sem}</option>)}
                    </select>
                  </div>
                )}

                {level && semester && (
                  <div>
                    <label className="text-xs font-semibold text-gray-300">المادة</label>
                    <select value={subject} onChange={(e) => setSubject(e.target.value)} className="w-full mt-1 bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm">
                      <option value="">-- اختر --</option>
                      {(ACADEMIC_DATA[level]?.[semester] || []).map(subj => <option key={subj} value={subj}>{subj}</option>)}
                    </select>
                  </div>
                )}
              </div>
            </div>
          </div>

          {/* Upload Panel */}
          <div className="lg:col-span-2 space-y-4">
            {/* Assignment Upload */}
            <div className="bg-gradient-to-br from-blue-500/10 to-cyan-500/10 border border-blue-500/20 rounded-2xl p-6">
              <h2 className="text-lg font-bold mb-4 flex items-center gap-2">
                <FileUp className="w-5 h-5 text-blue-400" /> ملف الواجب (من بيرسون)
              </h2>
              <div className="relative border-2 border-dashed border-blue-500/50 rounded-xl p-6 text-center cursor-pointer hover:border-blue-400 transition" onClick={() => assignmentRef.current?.click()}>
                {assignment ? (
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-3">
                      <FileText className="w-6 h-6 text-blue-400" />
                      <div className="text-left">
                        <p className="font-semibold">{assignment.name}</p>
                        <p className="text-xs text-gray-400">{assignment.content.length} حرف</p>
                      </div>
                    </div>
                    <button onClick={(e) => { e.stopPropagation(); setAssignment(null); setResult(null); }} className="text-red-400 hover:text-red-300"><Trash2 className="w-5 h-5" /></button>
                  </div>
                ) : (
                  <div>
                    <FileUp className="w-8 h-8 text-blue-400 mx-auto mb-2" />
                    <p className="font-semibold">اسحب ملفًا هنا أو انقر</p>
                    <p className="text-xs text-gray-400 mt-1">PDF, DOCX, PPTX, TXT (حتى 20 MB)</p>
                  </div>
                )}
                <input ref={assignmentRef} type="file" onChange={(e) => handleUpload(e, true)} accept=".pdf,.docx,.pptx,.txt" className="hidden" />
              </div>
            </div>

            {/* Evidence Upload */}
            <div className="bg-gradient-to-br from-green-500/10 to-emerald-500/10 border border-green-500/20 rounded-2xl p-6">
              <h2 className="text-lg font-bold mb-4 flex items-center gap-2">
                <Brain className="w-5 h-5 text-green-400" /> أدلة الطالب ({evidences.length}/{MAX_FILES})
              </h2>
              <div className="relative border-2 border-dashed border-green-500/50 rounded-xl p-6 text-center cursor-pointer hover:border-green-400 transition" onClick={() => evidencesRef.current?.click()}>
                <Brain className="w-8 h-8 text-green-400 mx-auto mb-2" />
                <p className="font-semibold">اسحب ملفات هنا أو انقر</p>
                <p className="text-xs text-gray-400 mt-1">أنواع متعددة (حتى 20 MB لكل ملف)</p>
                <input ref={evidencesRef} type="file" multiple onChange={(e) => handleUpload(e, false)} accept=".pdf,.docx,.pptx,.txt" className="hidden" />
              </div>
              {evidences.length > 0 && (
                <div className="mt-4 space-y-2 max-h-48 overflow-y-auto">
                  {evidences.map((f, i) => (
                    <div key={i} className="flex items-center justify-between bg-black/30 p-2 rounded">
                      <span className="text-sm truncate">{f.name}</span>
                      <button onClick={() => setEvidences(evidences.filter((_, j) => i !== j))} className="text-red-400 hover:text-red-300"><Trash2 className="w-4 h-4" /></button>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="flex gap-4 justify-center mb-8">
          <button onClick={handleEvaluate} disabled={isAnalyzing || !level || !semester || !subject || !assignment || !evidences.length} className="px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg font-bold flex items-center gap-2 transition">
            {isAnalyzing ? <Loader2 className="w-5 h-5 animate-spin" /> : <CheckCircle className="w-5 h-5" />}
            {isAnalyzing ? 'جاري التقييم...' : 'تقييم الآن'}
          </button>
        </div>

        {result && (
          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="bg-gradient-to-br from-black/50 to-cyan-950/20 border border-cyan-500/20 rounded-2xl p-8">
            <div className="text-center mb-8">
              <h2 className="text-gray-400 font-bold uppercase tracking-widest text-xs mb-4">الدرجة النهائية المستحقة</h2>
              <div className="text-8xl font-black text-cyan-400 mb-6 drop-shadow-2xl">{result.final_grade}</div>
              <p className="text-white text-lg max-w-3xl mx-auto leading-relaxed italic">"{result.summary}"</p>
            </div>

            {result.criteria && (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {Object.entries(result.criteria).map(([code, v]: any) => {
                  const achieved = !!v.achieved;
                  return (
                    <div key={code} className={`rounded-2xl border p-6 ${achieved ? 'bg-green-500/5 border-green-500/20' : 'bg-red-500/5 border-red-500/20'}`}>
                      <div className="flex justify-between items-start">
                        <div className="flex items-center gap-4">
                          <div className={`p-3 rounded-xl ${achieved ? 'bg-green-500/10 text-green-500' : 'bg-red-500/10 text-red-500'}`}>
                            {achieved ? <CheckCircle className="w-7 h-7" /> : <XCircle className="w-7 h-7" />}
                          </div>
                          <div>
                            <div className="text-2xl font-black text-white">{code}</div>
                            <div className="text-[10px] font-bold mt-1 px-2 py-0.5 rounded-full w-fit tracking-wider" style={{backgroundColor: v.band === 'DISTINCTION' ? 'rgba(234,179,8,0.2)' : v.band === 'MERIT' ? 'rgba(6,182,212,0.2)' : 'rgba(34,197,94,0.2)', color: v.band === 'DISTINCTION' ? '#fbbf24' : v.band === 'MERIT' ? '#22d3ee' : '#86efac'}}>
                              {v.band || '—'}
                            </div>
                          </div>
                        </div>
                        <button onClick={() => setExpandedCode(prev => prev === code ? null : code)} className="text-xs text-gray-400 hover:text-white">
                          التفاصيل
                        </button>
                      </div>

                      <AnimatePresence>
                        {expandedCode === code && (
                          <motion.div initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: 'auto' }} exit={{ opacity: 0, height: 0 }}>
                            <div className="mt-5 bg-white/5 p-4 rounded-xl border border-white/10">
                              <div className="text-xs text-gray-400 font-bold uppercase mb-1">السبب:</div>
                              <p className="text-sm text-gray-200 leading-relaxed">{v.feedback || '—'}</p>

                              {v.evidence_quote && v.evidence_quote !== 'No evidence' && (
                                <div className="mt-4 p-4 bg-black/30 rounded-xl border-r-4 border-cyan-500">
                                  <div className="text-[10px] text-cyan-400 font-bold uppercase mb-1">الاقتباس الداعم:</div>
                                  <p className="text-xs text-cyan-100/80 italic leading-relaxed">"{v.evidence_quote}"</p>
                                  <div className="mt-2 text-[10px] text-gray-400">درجة التحقق: {v.verification_score ?? 100}%</div>
                                </div>
                              )}
                            </div>
                          </motion.div>
                        )}
                      </AnimatePresence>
                    </div>
                  );
                })}
              </div>
            )}
          </motion.div>
        )}
      </div>
    </div>
  );
}
