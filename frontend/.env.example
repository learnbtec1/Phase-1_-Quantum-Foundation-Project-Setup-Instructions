# Copy to **`frontend/.env`** — Docker Compose mounts it as `env_file: ./frontend/.env` for the frontend service.
#
# `NEXT_PUBLIC_EMERGENCY_AUTH_FREEZE=true` — dev only: skips edge login redirects, seeds opaque token,
# aligns with backend `AUTH_DEV_BYPASS=true`. Never true in production builds.
## Deterministic checklist (recommended):
# 1. Do NOT use **`frontend/.env.local`** (Next merges it over `.env` in dev; Dockerfile ignores `*.env.local` anyway).
# 2. After changing **`NEXT_PUBLIC_*`**, rebuild: `docker compose --env-file ./frontend/.env build --no-cache frontend`
#    (`--env-file` makes Compose variable substitution use the same file as Docker `env_file` — avoids split-brain bake vs runtime.)
#    Without it, Compose still reads repo-root `.env` for `${NEXT_PUBLIC_*}` in `docker-compose.yml`.
# 3. Optional probe: `await window.__cogniSpeakWithTTS?.("اختبار نهائي")` → console shows **[TTS EDGE OK]** + **PLAY SUCCESS** / **avatar:speak**;
#    probe: `visemeCount > 0`, `audio.currentTime` advances while playing (Edge neural path).
#    If env is correct but this fails, suspect **AudioContext / autoplay policy / viseme payload** — not `.env`.
#
# Repo root `.env`: keep **`EDUVOR_*`** ports; avoid conflicting **`NEXT_PUBLIC_*`** there unless you intend them for compose substitution.

NODE_ENV=development

# ══════════════════════════════════════════════════════════════════════════════
# صوت المتصفح: Edge فقط (`/api/tts-with-timing` → FastAPI + `edge-tts`) — لا ElevenLabs
#
# لا تستخدم: NEXT_PUBLIC_ENABLE_WS_TTS_PLAYBACK (غير موجود في الكود)
# `/api/tts-elevenlabs` معطل (410).
#
# انسخ الأسطر التالية كما هي إلى frontend/.env ثم أعد بناء الحاوية.
# ══════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/agent

NEXT_PUBLIC_TTS_PROVIDER=edge
# يُستخدم للتوثيق/الواجهات فقط — الدمج إلى FastAPI لا يرسل voice؛ الصوت مقفل على الخادم.
NEXT_PUBLIC_TTS_EDGE_VOICE_DEFAULT=ar-SA-ZariyahNeural
NEXT_PUBLIC_USE_WS_AGENT_AUDIO=false

NEXT_PUBLIC_AUTH_DEV_INJECT=true
# Must match backend AUTH_DEV_STATIC_TOKEN when AUTH_DEV_BYPASS=true (legacy: NEXT_PUBLIC_DEV_AUTH_TOKEN).
NEXT_PUBLIC_DEV_TOKEN=test-token-123

NEXT_PUBLIC_DEBUG_TTS=true
NEXT_PUBLIC_DEBUG_FORCE_WEB_SPEECH_TTS=false

NEXT_PUBLIC_USE_AVATAR=false
NEXT_PUBLIC_AUTH_DEV_REDIRECT=/dashboard

# Optional alias — full REST prefix; trailing /api/v1 is stripped when resolving origins:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1

# Optional: WS preflight uses same-origin GET /health (Next rewrites to FastAPI). Set false only if needed.
# NEXT_PUBLIC_WS_PREFLIGHT_HEALTH=false

# Optional: verbose Cogni / avatar pipeline logs in the browser console (default OFF).
# NEXT_PUBLIC_DEBUG_AVATAR=true
# Override office room GLB (browser path under frontend/public/). Default: /models/office2.glb.
# NEXT_PUBLIC_OFFICE_GLB_URL=/models/office.glb

# Static 2D studio backdrop (`scene.background`) — default ON. Set false for full 3D office GLB.
# NEXT_PUBLIC_AVATAR_2D_ENV_BACKGROUND=false
# Optional PNG/JPEG under public/: NEXT_PUBLIC_AVATAR_2D_ENV_URL=/models/environments/office_final.png

# Optional: avatar motion pipeline (intent transitions + counters in __cogniAvatarDiag when DEBUG_AVATAR also set)
# NEXT_PUBLIC_DEBUG_MOTION_PIPELINE=true

# VRMA clips: procedural organic layers blend ratio 0–1 (unset = 0, legacy isolation). Typical 0.22–0.32.
# NEXT_PUBLIC_AVATAR_VRMA_PROCEDURAL_BLEED=0.28
# Optional: avatar motion pipeline diagnostics (rebuild after change)
# NEXT_PUBLIC_MOTION_PATH_LEAK_DEBUG=true
# NEXT_PUBLIC_MOTION_SPEAK_ACTIVE_IGNORE_RMS=true
# NEXT_PUBLIC_DEBUG_COGNI=true
# NEXT_PUBLIC_DEBUG_PHYSICS_COLLIDERS=true

# --- BFF → FastAPI Edge TTS ---
# لا يوجد احتياطي صوت من الواجهة؛ الصوت النهائي من الخادم فقط (`EDGE_TTS_VOICE_LOCKED_GLOBAL`).
# Voice للـ FastAPI: backend/.env (توثيق) — الواجهة لا ترسل حقول voice.
# Dev/local: allow POST without Bearer on TTS routes (never in production):
# COGNI_BFF_DEV_BYPASS_AUTH=true
# Guest WS path (separate from Golden Ticket):
# NEXT_PUBLIC_COGNI_WS_ALLOW_ANONYMOUS=true
# NEXT_PUBLIC_TTS_WEB_SPEECH_FALLBACK=false
# NEXT_PUBLIC_TTS_SILENT_WITHOUT_AUTH=true

# Forensic avatar TTS elimination (staging — ONE flag at a time → rebuild after each toggle)
# NEXT_PUBLIC_FORENSIC_HTTP_TTS_ONLY=1
# NEXT_PUBLIC_FORENSIC_BYPASS_STRIP_MARKUP=1
# NEXT_PUBLIC_WS_TTS_DURATION_MIN_RATIO=0.6
# NEXT_PUBLIC_WS_HTTP_TTS_DEFER_MS=48
# NEXT_PUBLIC_WS_SPEECH_DATA_MIN_B64_CHARS=200

# Optional: Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: set "false" to skip edge redirects and use only `AuthGuard` (headers still apply)
# ENABLE_EDGE_AUTH=true

# Local `next dev`: do NOT set BACKEND_INTERNAL_URL=http://backend:8000 — Docker-internal hostname only.
# BACKEND_INTERNAL_URL=http://backend:8000
