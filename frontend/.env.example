# Copy to .env.local and fill in values

# Backend API (for Chat bridge) — use 8000 to match docker-compose `backend` port mapping
NEXT_PUBLIC_API_URL=http://localhost:8000

# Simulation page gate — set to "true" to enable the 3D office simulation
# Default: disabled (omit or set to "false")
NEXT_PUBLIC_SIMULATION_ENABLED=false

# OpenAI (for TTS, AI features)
OPENAI_API_KEY=
# Optional: OpenAI TTS voice for /api/voice-arabic (onyx/echo = male-presenting; avoid shimmer for Cogni)
# OPENAI_TTS_VOICE=onyx

# Optional: ElevenLabs TTS fallback
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Avatar VRM Override ──────────────────────────────────────────────────────
# Leave blank to use the default VRM_FALLBACKS chain from avatar.ts
NEXT_PUBLIC_AVATAR_VRM_URL=
# Optional fine-tune after automatic foot–floor calibration (metres; negative = sink slightly)
# NEXT_PUBLIC_AVATAR_STAND_Y_OFFSET=0
# Added to carpet mesh world max Y when setting logical floor (code default 0.10 m if unset).
# Tune with dev console snippet (AvatarCanvas): suggest_extra_m ≈ value to add when feet float above carpet.
# Example: feet ~0.15 m above floorY → set to 0.15 (then rebuild frontend). Negative avg_m → reduce extra.
# NEXT_PUBLIC_RUG_WALK_SURFACE_Y_EXTRA=0.10
# Optional seated avatar group Y trim (metres), after foot calibration — stacks with VRM1 constant in avatar.ts
# NEXT_PUBLIC_AVATAR_SIT_Y_OFFSET=0
# Optional body yaw base in radians (unset = auto: π for VRM 0.x, 0 for VRM 1.0)
# NEXT_PUBLIC_AVATAR_FACING_YAW_BASE=

# ── Avatar Feature Flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_USE_HUMANIZATION=true
NEXT_PUBLIC_USE_IK=false
NEXT_PUBLIC_USE_CAMERA_GAZE=false
NEXT_PUBLIC_USE_VISEME_PREDICT=false
