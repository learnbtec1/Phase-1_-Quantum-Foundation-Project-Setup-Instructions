# Copy to .env.local and fill in values

# Backend API (for Chat bridge)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Simulation page gate — set to "true" to enable the 3D office simulation
# Default: disabled (omit or set to "false")
NEXT_PUBLIC_SIMULATION_ENABLED=false

# OpenAI (for TTS, AI features)
OPENAI_API_KEY=

# Optional: ElevenLabs TTS fallback
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Avatar VRM Override ──────────────────────────────────────────────────────
# Leave blank to use the default VRM_FALLBACKS chain from avatar.ts (default: /models/cogni_final.vrm)
# NEXT_PUBLIC_AVATAR_VRM_URL=/models/cogni_final.vrm
NEXT_PUBLIC_AVATAR_VRM_URL=

# Rug / carpet — small lift so feet sit slightly above the mesh (metres)
NEXT_PUBLIC_RUG_WALK_SURFACE_Y_EXTRA=0.015

# 3D floor environment: DEFAULT = carpet.glb + AABB floor; OFFICE = /models/office/office.glb + fixed physicsY/rugExtra
# For Docker: also set in repo root `.env` (docker-compose passes NEXT_PUBLIC_ACTIVE_ENV into the frontend container).
# NEXT_PUBLIC_ACTIVE_ENV=DEFAULT
# NEXT_PUBLIC_ACTIVE_ENV=OFFICE

# ── Avatar Feature Flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_USE_HUMANIZATION=true
NEXT_PUBLIC_USE_IK=false
NEXT_PUBLIC_USE_CAMERA_GAZE=false
NEXT_PUBLIC_USE_VISEME_PREDICT=false
