# Copy to .env.local and fill in values
#
# Full testing guide: frontend/TESTING.md (unit, integration, E2E, CI/CD).
#
# Single motion authority: useBrainStore.avatarBehavior drives VRMSkeletonManager; AgentDirector body gestures off.
# Set to false to restore legacy director + avatar:gesture pipeline.
# NEXT_PUBLIC_AVATAR_BEHAVIOR_SINGLE_CONTROLLER=false
# Combined CI gate (manual): .github/workflows/ci-complete.yml — frontend + backend + E2E; optional deploy after green.

# ── Frontend testing (this project does NOT use Jest for unit tests) ───────────────────────
#   • Unit: Node.js built-in test runner (`node:test`) + `tsx` where `@/` imports are needed.
#   • E2E / UI: Playwright (`npx playwright test`, see playwright.config.ts; CI: .github/workflows/e2e.yml).
#   • Unit CI: .github/workflows/frontend-unit.yml — runs on push/PR when `frontend/**` changes.
#   • Full gate: .github/workflows/ci-complete.yml — run from GitHub Actions UI (optional deploy step).
#   Scripts (from `frontend/`): test:ws-url | test:brain | test:normalize | test:unit | test:integration | test:ci
#   • test:ws-url    → src/lib/wsAgentUrl.test.ts
#   • test:brain     → src/store/useBrainStore.brain.test.ts (processFrame / tickIntentBrain)
#   • test:normalize → src/utils/events/__tests__/normalizeAvatarEvents.test.ts
#   • test:unit      → all of the above (does not run Playwright or src/__tests__/evaluate-validation.test.ts)
#
# Playwright (local / CI): see playwright.config.ts — `CI=true` in GitHub skips dev-server reuse;
# `PW_BASE_URL` overrides base URL; `SKIP_WEBSERVER=1` if the app is already running elsewhere.
#
# Debug / trace env (optional; for local debugging — not “tested” by unit tests, but documented here):
# NEXT_PUBLIC_COGNI_INTEGRATION_TRACE=true   — verbose WS frame logging in useAgentAgent (dev aid).
# NEXT_PUBLIC_DEBUG_FACE_SYNC=true            — throttled [Face-Sync] lip-sync debug logs (see lip-sync section below).

# Digital human observability: FPS, lip drift, motion diagnostics, rule-engine insights (HUD bottom-left). Default off.
# NEXT_PUBLIC_COGNI_OBSERVABILITY=true

# Forensic motion pipeline: throttled console JSON for VRMSkeletonManager + cinematic + applyFinalPose (speaking, energy, gestureLayerW, stabilizeMix, layer flags).
# NEXT_PUBLIC_MOTION_PIPELINE_DEBUG=true

# Demo only: allow root `hooks/useAuth.ts` mock login in production builds (default: off — mock works in `next dev` without this).
# NEXT_PUBLIC_ALLOW_MOCK_AUTH=true

# Dev only: if no JWT in localStorage on load, inject a placeholder into cogni_access_token (see bootstrapAuthLifecycle in lib/auth.ts).
# Pair with backend COGNI_DEV_BYPASS_AUTH if the placeholder is not a real JWT.
# NEXT_PUBLIC_AUTH_DEV_INJECT=true
# NEXT_PUBLIC_DEV_AUTH_TOKEN=dev-token-123

# Phase 4 — CSP: default is Content-Security-Policy-Report-Only (see next.config.js). Set true to enforce.
# CSP_ENFORCE=true

# Optional: عند التوسعة يمكن قراءته في الكود لتفعيل سجلات العميل في التطوير فقط (الافتراضي: لا شيء = صامت في الإنتاج)
# NEXT_PUBLIC_LOG_LEVEL=INFO

# Backend API — use 127.0.0.1 in dev to match WebSocket (avoids localhost/IPv6 issues).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Generative kinematic WebSocket (`python backend/avatar_brain.py`). JSON: { "bones": { "rua": { "x","y","z" } }, ... }.
# Set NEXT_PUBLIC_ENABLE_GENERATIVE_GESTURES=false when avatar_brain is not running to avoid reconnect noise.
# NEXT_PUBLIC_ENABLE_GENERATIVE_GESTURES=false
# Use 127.0.0.1 to match IPv4 loopback (see GenerativeGestureManager). Do not run uvicorn on the same port simultaneously.
# Docker Compose: avatar_brain is published as host 8011 → container 8001 (avoids common :8001 conflicts on the host).
# NEXT_PUBLIC_GENERATIVE_GESTURE_WS=ws://127.0.0.1:8011
# Optional: cap reconnect attempts when the service is down (default 8).
# NEXT_PUBLIC_GENERATIVE_GESTURE_MAX_RECONNECTS=8
# WebSocket URL for /ws/agent — highest priority in buildDefaultWsAgentUrl() (then NEXT_PUBLIC_AGENT_WS, then derived from NEXT_PUBLIC_API_URL).
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/agent
# Optional legacy alias (same as NEXT_PUBLIC_WS_URL if you only set one).
# NEXT_PUBLIC_AGENT_WS=ws://127.0.0.1:8000/ws/agent
# Guest WebSocket + optional TTS without browser JWT (must match backend COGNI_WS_ALLOW_ANONYMOUS + COGNI_DEV_BYPASS_AUTH).
# NEXT_PUBLIC_COGNI_WS_ALLOW_ANONYMOUS=true
# Dev-only: ISO timestamps + compact metadata for each inbound WS frame (excludes pong). Complements [useAgentAgent] logs.
# NEXT_PUBLIC_COGNI_INTEGRATION_TRACE=true
# Before WebSocket: GET /api/health on the same host/port (default on) to avoid Chromium’s red “WebSocket connection failed” when the API is not running. Set false only if /api/health is blocked.
# NEXT_PUBLIC_WS_PREFLIGHT_HEALTH=true
# Agent WS: use `speech_data` MP3 + visemes as the only playback path (no duplicate AgentDirector → /api/tts-with-timing). Default on; set false to force HTTP TTS for every reply.
# NEXT_PUBLIC_USE_WS_AGENT_AUDIO=true
# Legacy alias (docker-compose): NEXT_PUBLIC_COGNI_WS_GUEST_OK=true
# Next.js server only — allow BFF /api/tts-with-timing with no Bearer; forwards to Python without Authorization.
# COGNI_BFF_DEV_BYPASS_AUTH=true

# Local dev: Next.js BFF allows /api/tts-with-timing without browser Bearer; forwards Authorization: Bearer cogni-dev-bypass.
# Set the same flag on the Python backend (COGNI_DEV_BYPASS_AUTH=true) so upstream accepts the stub user.
# COGNI_DEV_BYPASS_AUTH=true
# COGNI_BFF_DEV_BYPASS_AUTH=true
# Optional: explicit Python API URL for Next.js server-only fetch (speech-token auth, etc.). Falls back to NEXT_PUBLIC_API_URL.
# BACKEND_URL=http://localhost:8001

# Production: expose paid AI BFF routes (/api/ai/query, /api/ai/ingest, /api/openai-grade). Default off; still require Authorization: Bearer on every request.
# ENABLE_PUBLIC_AI_ROUTES=false

# Production: enable /api/avatar-config (per-user server prefs). Default off in production builds.
# ENABLE_AVATAR_CONFIG_API=false

# Simulation page gate — set to "true" to enable the 3D office simulation
# Default: disabled (omit or set to "false")
NEXT_PUBLIC_SIMULATION_ENABLED=false

# Gesture calibration panels (GestureCalibrator + MouseGestureCalibrator on AvatarCanvas). true/1 = show; false/0 = hide.
# Unset in development = show; unset in production = hide. See showGestureCalibrationUi() in src/config/avatar.ts.
# NEXT_PUBLIC_SHOW_GESTURE_CALIB=true

# Azure Speech — server-only for GET /api/speech-token (browser SDK lip-sync; never NEXT_PUBLIC_ the key)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# Recovery protocol: single audio path is AgentDirector → speakWithTTS → /api/tts-with-timing (NEXT_PUBLIC_USE_AGENT_MESSAGE_AZURE_TTS / MIME simulation removed from AgentDirector).

# [Deprecated env — ignored for TTS routing] Previously Canvas Azure SDK or MIME simulation.
# NEXT_PUBLIC_USE_AGENT_MESSAGE_AZURE_TTS=true
# NEXT_PUBLIC_MIME_MODE=false

# OpenAI (for TTS, AI features)
OPENAI_API_KEY=

# ElevenLabs — Next BFF `/api/tts-elevenlabs` reads these (docker-compose also passes them into `frontend` service).
# Backend FastAPI TTS uses the same names when `TTS_PROVIDER=elevenlabs` in backend `.env`.
ELEVENLABS_API_KEY=
# Pre-made: Bella EXAVITQu4vr4xnSDxMaL | Rachel 21m00Tcm4TlvDq8ikWAM | Antoni ErXw76R81vOYoY16j2i9
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# speakWithTTS uses this route when:
# NEXT_PUBLIC_TTS_PROVIDER=elevenlabs
# Lip-sync / face (browser, baked at build): server logs [BFF] [TTS-SYNC]; client optional [Face-Sync] when DEBUG_FACE_SYNC.
# Preferred calibration — face/lip playhead (overrides TTS_* below when set):
# NEXT_PUBLIC_FACE_SYNC_OFFSET_MS — ms vs audio; try 80–120 until lips match ElevenLabs.
# NEXT_PUBLIC_FACE_PREATTACK_MS — optional ms to advance viseme cue lookup (e.g. 50).
# Legacy aliases (used if corresponding FACE_* is unset):
# NEXT_PUBLIC_TTS_SYNC_OFFSET_MS
# NEXT_PUBLIC_TTS_MOUTH_PREATTACK_MS
# NEXT_PUBLIC_DEBUG_FACE_SYNC=true — throttle [Face-Sync] logs (~2s): playheadSec, cues, lipRms, driftMs.
# NEXT_PUBLIC_FACE_SYNC_OFFSET_MS=100
# NEXT_PUBLIC_FACE_PREATTACK_MS=50

# Digital Human: slightly stronger continuous torso breath in `presenceLayer` (default on). Set `false` to tone down.
# NEXT_PUBLIC_AVATAR_ENHANCED_BREATHING=false

# ── Avatar VRM Override ──────────────────────────────────────────────────────
# Canonical model: public/models/195_Uta01/cogni.vrm (omit this line to use pickVrmUrl() default)
NEXT_PUBLIC_AVATAR_VRM_URL=/models/195_Uta01/cogni.vrm

# Rug / carpet — small lift so feet sit slightly above the mesh (metres)
NEXT_PUBLIC_RUG_WALK_SURFACE_Y_EXTRA=0.015

# 3D floor: DEFAULT and OFFICE both use /models/office/office.glb (see avatar.ts ENV_MODELS).
# NEXT_PUBLIC_ACTIVE_ENV=DEFAULT
# NEXT_PUBLIC_ACTIVE_ENV=OFFICE
NEXT_PUBLIC_ACTIVE_ENV=

# Level 6 unified behavior: true = BehaviorBrainHost drives staggered motion (avatar:gesture → VRMA map).
# false or omit = AgentDirector + UnifiedGestureEngine can dispatch `avatar:vrma:play` (VRMA from director).
NEXT_PUBLIC_LEVEL6_UNIFIED_BEHAVIOR=false

# Optional: fire one VRMA clip after VRM loads (smoke test — same as window.VRM_ANIMATION.playVRMA)
# NEXT_PUBLIC_VRMA_PLAY_ON_LOAD=/models/animations/VRMA_MotionPack/vrma/VRMA_02.vrma

# When true: no pre-baked .vrma mixer clips (macro body). Procedural breathing, blink, lip-sync, lookAt stay on.
# NEXT_PUBLIC_DISABLE_VRMA=true

# Foot calibration drift watchdog (interval + force recalib). Default off — can fight pose animation.
# NEXT_PUBLIC_FLOOR_CALIB_WATCHDOG=true

# ── Environment (office GLB) vertical only — added ONLY to OfficeSceneWithEditor room group Y (not AvatarRoot/camera).
# Negative = lower room toward world Y=0. Use with NEXT_PUBLIC_DEBUG_FLOOR_GRID=true to line up with floor.
# NEXT_PUBLIC_OFFICE_ENV_Y_OFFSET=-1.2

# ── Avatar Feature Flags ─────────────────────────────────────────────────────
NEXT_PUBLIC_USE_HUMANIZATION=true
NEXT_PUBLIC_USE_IK=false
NEXT_PUBLIC_USE_CAMERA_GAZE=false
NEXT_PUBLIC_USE_VISEME_PREDICT=false
# Rare: allow a second TTS call on the client to fetch visemes when WS audio has none (dev only).
# NEXT_PUBLIC_COGNI_ALLOW_CLIENT_VISEME_FETCH=true

# Log every speakWithTTS() entry to console: [speakWithTTS] 🔊 TTS CALLED
# NEXT_PUBLIC_DEBUG_TTS=true

# true = play WS `speech` frames (server MP3/PCM). false = client-side AgentDirector → speakWithTTS (/api/tts-with-timing)
# WebSocket base64 audio playback removed — client `/api/tts-with-timing` (speakWithTTS) is the only path.

# Lip-sync drift probe (audio vs cue time, ms) — logs to console ~4 Hz when avatar speaks
# NEXT_PUBLIC_DEBUG_LIP_DRIFT=true
# VRMSkeletonManager: arm-fallback / vrmaForBlend key logs (off by default)
# NEXT_PUBLIC_DEBUG_MOTION=true
# Disable timer/random injectors: TTS nods, behavior brain micros, spontaneous idle, co-speech + transcript nods (VRMA + explicit play unchanged)
# NEXT_PUBLIC_DISABLE_AUTOMATIC_GESTURE_INJECTORS=true
# Re-enable periodic nod + embodiment failsafe micro-gestures during VRMA (default off)
# NEXT_PUBLIC_VRMA_IDLE_MICRO_INJECT=true
# Co-speech / structured performance anchor vs playback start (ms). Default 420.
# NEXT_PUBLIC_COGNI_COSPEECH_BASE_OFFSET_MS=420
# Optional: schedule WS `behavior` gestures via @/lib/behavior after audio onplay (default off; can overlap if misused).
# NEXT_PUBLIC_COGNI_BEHAVIOR_HANDLER_ON_PLAY=true
# Full-body idle procedural (hips, shoulders, etc.). Default OFF — set "true" to enable.
# NEXT_PUBLIC_ENABLE_FULL_BODY_PROCEDURAL=true
# Mic button on avatar-agent (default: shown). Set "false" to hide.
# NEXT_PUBLIC_COGNI_ENABLE_MIC=true
# Optional: reduce procedural / gaze load during debugging
# NEXT_PUBLIC_COGNI_ENABLE_EYE_TRACKING=false
# NEXT_PUBLIC_COGNI_ENABLE_INTERRUPTION=true

# VRMSkeletonManager: one-shot rightUpperArm local axis calibration (3s; console). Set false or remove after tuning.
NEXT_PUBLIC_DEBUG_LOCAL_AXIS_CALIB=true
