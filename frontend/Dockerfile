# EDUVERS-CORE — Next.js 14 (standalone). Browser calls API at NEXT_PUBLIC_API_URL (usually host:8000).
FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

FROM base AS builder
WORKDIR /app
# Browser shows this; rewrites in next.config use BACKEND_INTERNAL_URL to reach API from the Next container
ARG NEXT_PUBLIC_API_URL=http://localhost:8001
ARG NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws/agent
ARG NEXT_PUBLIC_TTS_PROVIDER=edge
ARG NEXT_PUBLIC_USE_WS_AGENT_AUDIO=false
ARG NEXT_PUBLIC_DEBUG_TTS=false
ARG NEXT_PUBLIC_DEBUG_FORCE_WEB_SPEECH_TTS=
ARG NEXT_PUBLIC_AUTH_DEV_INJECT=
ARG NEXT_PUBLIC_DEV_TOKEN=
ARG NEXT_PUBLIC_DEV_AUTH_TOKEN=
ARG NEXT_PUBLIC_AUTH_DEV_REDIRECT=
ARG NEXT_PUBLIC_EMERGENCY_AUTH_FREEZE=false
ARG BACKEND_INTERNAL_URL=http://backend:8000
ARG NEXT_PUBLIC_USE_AVATAR=false
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_TTS_PROVIDER=$NEXT_PUBLIC_TTS_PROVIDER
ENV NEXT_PUBLIC_USE_WS_AGENT_AUDIO=$NEXT_PUBLIC_USE_WS_AGENT_AUDIO
ENV NEXT_PUBLIC_DEBUG_TTS=$NEXT_PUBLIC_DEBUG_TTS
ENV NEXT_PUBLIC_DEBUG_FORCE_WEB_SPEECH_TTS=$NEXT_PUBLIC_DEBUG_FORCE_WEB_SPEECH_TTS
ENV NEXT_PUBLIC_AUTH_DEV_INJECT=$NEXT_PUBLIC_AUTH_DEV_INJECT
ENV NEXT_PUBLIC_DEV_TOKEN=$NEXT_PUBLIC_DEV_TOKEN
ENV NEXT_PUBLIC_DEV_AUTH_TOKEN=$NEXT_PUBLIC_DEV_AUTH_TOKEN
ENV NEXT_PUBLIC_AUTH_DEV_REDIRECT=$NEXT_PUBLIC_AUTH_DEV_REDIRECT
ENV NEXT_PUBLIC_EMERGENCY_AUTH_FREEZE=$NEXT_PUBLIC_EMERGENCY_AUTH_FREEZE
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_USE_AVATAR=$NEXT_PUBLIC_USE_AVATAR
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
