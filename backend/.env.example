# =================================================================
# 🚀 SERVER & CORE SETTINGS (Docker Compatible)
# =================================================================
PORT=8000
# 🚨 يجب أن يكون 0.0.0.0 ليعمل داخل حاويات الدوكر
HOST=0.0.0.0
ENVIRONMENT=development
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
DEBUG=true
API_V1_STR=/api/v1

# =================================================================
# 🗄️ DATABASE & MEMORY (PostgreSQL & Redis)
# =================================================================
# رابط قاعدة البيانات داخل شبكة دوكر
DATABASE_URL=postgresql+psycopg2://nexus:nexus@db:5432/nexus
USE_DB=true
REDIS_URL=redis://nexus_redis:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =================================================================
# 🇯🇴 AUDIO & TTS (Cogni - The Sovereign Teacher)
# =================================================================
# 🚨 المحرك السيادي المعتمد لمشروع كوجني
TTS_PROVIDER=azure
TTS_DISABLE_NON_AZURE_FALLBACK=true
TTS_FALLBACK_ALLOW_DEV=false
TTS_ALLOW_GTTS_ARABIC_FALLBACK=false
TTS_AZURE_429_FALLBACK_EDGE=0

# مسارات ملفات الصوت داخل الدوكر
AUDIO_DIR=/app/data/audio
STORE_DIR=/app/data/store

# إعدادات Azure 
AZURE_SPEECH_KEY=your_azure_key_here
AZURE_SPEECH_REGION=eastus
TTS_ARABIC_VOICE=ar-JO-TaimNeural
TTS_ARABIC_VOICE_FEMALE=ar-JO-SanaNeural
TTS_FORMAT=riff-24khz-16bit-mono-pcm
TTS_WITH_TIMING=true
TTS_TIMEOUT_SECONDS=20
COGNI_ARABIC_TTS_VOICE_LOCKED=ar-JO-TaimNeural
EDGE_TTS_ATTEMPTS=3
EDGE_TTS_TIMEOUT_SEC=35

# =================================================================
# 🧠 AI ENGINES (OpenAI & Anthropic)
# =================================================================
# المفتاح الأصلي لضمان عمل كوجني فوراً
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# نموذج التقييم المعتمد (يفضل GPT-4o للدقة في معايير BTEC)
GRADER_MODEL=gpt-4o
TUTOR_MODEL=gpt-4o
TUTOR_MODEL_FREE=gpt-4o-mini
GRADER_MAX_TOKENS=2000
GRADER_HARD_DEADLINE_SEC=120

# =================================================================
# 📂 VECTOR DATABASE & RAG (Pinecone & BTEC Corpus)
# =================================================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=aws
PINECONE_INDEX_NAME=learnmore
PINECONE_REGION=us-east-1
PINECONE_HOST=your_pinecone_host_url_here

# إعدادات البحث المحلي (RAG)
LOCAL_RAG_ENABLED=true
LOCAL_RAG_DIR=/app/btec_corpus

# =================================================================
# 🛡️ CONTENT INTEGRITY & SECURITY
# =================================================================
JWT_SECRET=change_this_in_production
JWT_ALGORITHM=HS256
PLAGIARISM_MIN_LEN=80
PLAGIARISM_STRICT=false

# =================================================================
# 🎓 COGNI BTEC FEATURES (Scaffolding & Performance)
# =================================================================
ENABLE_TUTORIAL_PERSISTENCE=true
COGNI_AUTO_BTEC_SCAFFOLDING=true
COGNI_PEDAGOGICAL_PERFORMANCE=true
COGNI_STAGE_GESTURES=true
COGNI_PERFORMANCE_JSON_MODE=true
ENABLE_HAND_COLLIDERS=true
NEXT_PUBLIC_RUG_WALK_SURFACE_Y_EXTRA=0.00
NEXT_PUBLIC_AVATAR_STAND_Y_OFFSET=-0.05