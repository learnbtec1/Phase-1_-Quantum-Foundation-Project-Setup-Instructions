# ===== Anthropic Claude API (مطلوب للتقييم) =====
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===== OpenAI API (اختياري — للخدمات الأخرى مثل الشات) =====
OPENAI_API_KEY=sk-your-openai-key-here

# ===== Google Custom Search (اختياري — للبحث الخارجي) =====
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CX_ID=your-google-cx-id

# ===== تكوين التقييم (Grading Engine — OpenAI) =====
# Must be a valid OpenAI model (e.g. gpt-4o). Claude models require Anthropic client (different implementation).
GRADER_MODEL=gpt-4o
GRADER_MAX_TOKENS=2000
GRADER_HARD_DEADLINE_SEC=120
GRADER_REQUEST_TIMEOUT=60
GRADER_MAX_CONCURRENT=5
GRADER_CACHE_TTL=86400

# ===== تكوين السيرفر =====
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DATABASE_URL=sqlite:///./test.db
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
DEBUG=true

# ===== إعدادات كشف الانتحال (Plagiarism) =====
PLAGIARISM_MIN_LEN=80
PLAGIARISM_STRICT=false
