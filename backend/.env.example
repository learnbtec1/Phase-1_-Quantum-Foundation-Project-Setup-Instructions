# انسخ إلى backend/.env — لا ترفع الأسرار إلى Git.
# docker compose يحمّل هذا الملف للخدمة backend — اسم الحاوية: eduvor-backend (وليس eduverse_backend).
#
# DATABASE_URL داخل Docker: المضيف db هو خدمة Postgres في Compose؛ كلمة المرور والمستخدم والاسم يطابقون
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB في ملف الجذر `.env`.
DATABASE_URL=postgresql://eduvor:eduvor_dev_change_me@db:5432/eduvor_core
JWT_SECRET_KEY=change_me_use_a_long_random_string

# --- TTS (Microsoft Edge only — edge-tts) ---
# Voice is **locked in code** to ar-SA-ZariyahNeural (see app.services.tts_service). These vars are documentation only.
TTS_PROVIDER=edge
EDGE_TTS_VOICE=ar-SA-ZariyahNeural
TTS_ARABIC_VOICE=ar-SA-ZariyahNeural
# Fail if MP3 shorter than N bytes after synth (default 1200 — avoid fake “success”)
# EDGE_TTS_MIN_AUDIO_BYTES=1200
# EDGE_TTS_TIMEOUT_SEC=120
# EDGE_TTS_PROXY=

# Redis: يُضبَط غالبًا من docker-compose عبر REDIS_URL=redis://redis:6379/0 — يمكن تكراره هنا للتوضيح فقط:
# REDIS_URL=redis://redis:6379/0

# --- مطابقة مع frontend/.env: NEXT_PUBLIC_DEV_TOKEN (أو LEGACY: NEXT_PUBLIC_DEV_AUTH_TOKEN) ==
#     AUTH_DEV_STATIC_TOKEN عندما AUTH_DEV_BYPASS=true. لا تفعّل في الإنتاج.
AUTH_DEV_BYPASS=true
AUTH_DEV_STATIC_TOKEN=test-token-123
AUTH_DEV_STATIC_USER_ID=1
# Optional WS-only aliases (same demo token). OR set AUTH_DEV_BYPASS=true — accepts test-token-123 even if STATIC mismatched.
# COGNI_WS_ALLOW_ANONYMOUS=true
# COGNI_BFF_DEV_BYPASS_AUTH=true
# COGNI_WS_DEV_STATIC_TOKEN=test-token-123

# Login blocks unverified accounts when true (default). Set false only if legacy rows have is_verified=false and mail cannot be fixed.
# When MAIL_USERNAME + MAIL_PASSWORD are empty, new registrations are marked verified automatically (see app/core/mail.py).
# REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=true
