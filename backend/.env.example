# ===== Anthropic Claude API (للتقييم — يُستخدم عند GRADER_MODEL=claude-*) =====
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===== OpenAI API (للتقييم — يُستخدم عند GRADER_MODEL=gpt-* أو للخدمات الأخرى) =====
OPENAI_API_KEY=sk-your-openai-key-here

# ===== Google Custom Search (اختياري — للبحث الخارجي) =====
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CX_ID=your-google-cx-id

# ===== TTS — Microsoft Edge (edge-tts) افتراضي، أو ElevenLabs (مفاتيح على السيرفر فقط) =====
# Python package: pip install -r requirements.txt يتضمن edge-tts==7.0.0 (مطلوب لتوليف Edge على الخادم).
TTS_PROVIDER=edge
# TTS_PROVIDER=elevenlabs
# Cloud/datacenter: Edge TTS WebSocket often returns 403 — disable Edge after EL and fix keys:
# TTS_EDGE_FALLBACK_AFTER_ELEVENLABS=false
# When false, ElevenLabs failures return 502 with no Edge fallback (debug / force EL-only).
# TTS_ALLOW_FALLBACK=true
# مطلوبان على عملية FastAPI عندما TTS_PROVIDER=elevenlabs (لا تضعها في NEXT_PUBLIC_*):
# ELEVENLABS_API_KEY=
# Pre-made: Bella EXAVITQu4vr4xnSDxMaL | Rachel 21m00Tcm4TlvDq8ikWAM | Antoni ErXw76R81vOYoY16j2i9
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_TTS_TIMEOUT_SEC=120
EDGE_TTS_VOICE=ar-JO-TaimNeural
TTS_ARABIC_VOICE=ar-JO-TaimNeural
# مهلة طلب طويل للنصوص الكبيرة (ثوانٍ)
# EDGE_TTS_TIMEOUT_SEC=120

# ===== تكوين التقييم (Grading Engine — Dual Provider Support) =====
# يدعم النظام كلاً من OpenAI و Anthropic Claude:
# - للاستخدام مع Claude: GRADER_MODEL=claude-sonnet-4-5 أو claude-sonnet-4-6
# - للاستخدام مع OpenAI (الإنتاج الافتراضي): GRADER_MODEL=gpt-5
# الافتراضي في الكود: gpt-5 — للتقييم الصارم. استخدم claude-sonnet-4-5 إن رغبت في Claude.
GRADER_MODEL=gpt-5
GRADER_MAX_TOKENS=2000
GRADER_HARD_DEADLINE_SEC=120
GRADER_REQUEST_TIMEOUT=60
GRADER_MAX_CONCURRENT=5
GRADER_CACHE_TTL=86400

# ===== تكوين السيرفر =====
API_V1_STR=/api/v1
# Phase 5 — production: comma-separated hostnames for TrustedHostMiddleware (no scheme). Empty = middleware disabled (discouraged).
# ALLOWED_HOSTS=api.example.com
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# مصادر إضافية (مفصولة بمسافات) تُدمج مع القائمة أعلاه دون تكرار — انظر app.main.ALLOW_ORIGINS
# EXTRA_ORIGINS=https://your-frontend.azurewebsites.net
DATABASE_URL=sqlite:///./test.db

# ===== الذاكرة الدائمة (PostgreSQL) ─────────────────────────────────────────
# USE_DB=false (افتراضي) → تخزين مؤقت InMemory
# USE_DB=true → حفظ التقييمات في PostgreSQL (مطلوب لربط التقييم بالأفاتار بعد إعادة فتح الصفحة)
USE_DB=false
# مثال إنتاج: USE_DB=true و DATABASE_URL لـ Postgres (docker-compose / Azure)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/eduverse_db
# بدون Docker: اترك USE_DB=false واضبط SQLite لتفادي الحاجة لـ psycopg2 محلياً
# DATABASE_URL=sqlite:///./test.db
POSTGRES_USER=eduverse
POSTGRES_PASSWORD=eduverse_secret
POSTGRES_DB=eduverse_db
PORT=8000
# Bind address: 127.0.0.1 = localhost only. For Docker / external access use 0.0.0.0 (matches `backend/run_server.py` uvicorn --host 0.0.0.0).
HOST=127.0.0.1
# HOST=0.0.0.0
# ── Phase 4 — إنتاج / أسرار / health ───────────────────────────────────────
# ENV أو ENVIRONMENT: في production يُرفض بدء التطبيق إن كان JWT_SECRET افتراضياً أو ضعيفاً (<32 حرفاً).
ENVIRONMENT=development
# للإنتاج: ENVIRONMENT=production و JWT_SECRET عشوائي طويل (مثلاً openssl rand -hex 32)
# AUTO_CREATE_TABLES: إن لم تُعرّف → true في التطوير، false في الإنتاج. الإنتاج: استخدم Alembic:
#   cd backend && alembic upgrade head
# AUTO_CREATE_TABLES=false
DEBUG=true
# مستوى سجلات Python (uvicorn/root). للإنتاج استخدم INFO لتقليل DEBUG.
LOG_LEVEL=INFO

# ===== إعدادات كشف الانتحال (Plagiarism) =====
PLAGIARISM_MIN_LEN=80
PLAGIARISM_STRICT=false

# ── TTS — صوت عربي (Edge TTS / إعدادات كوجني) ─────────────────────────────────
# يُقرأ من Settings.TTS_ARABIC_VOICE؛ WebSocket والمسارات تستخدم Edge TTS مع نفس الصوت.
TTS_ARABIC_VOICE=ar-JO-TaimNeural
# TTS_ARABIC_VOICE_FEMALE=ar-JO-SanaNeural

# ── Jordanian dialect lock (TTS + text pass) ───────────────────────────────────
# TTS_FORCE_JORDANIAN=true
# TTS_ARABIC_VOICE_FALLBACK=ar-JO-TaimNeural
# TTS_REJECT_EGYPTIAN_VOCABULARY=true
# TTS_EDGE_FALLBACK_VOICE=ar-JO-TaimNeural
# TTS_LOG_DIALECT_CORRECTIONS=true

# ── STT Configuration ────────────────────────────────────────────────────────
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
STT_MIN_MS=400
STT_MAX_MB=8
STT_MIME_OK=audio/webm,audio/ogg,audio/wav,audio/mp4
# Optional: Arabic primer for faster-whisper (keep short; long BTEC rubric text can bias hallucinations)
# WHISPER_INITIAL_PROMPT=حوار تعليمي بالعربية بين طالب ومعلم.

# ── WebSocket Heartbeat ──────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SEC=15

# ── Phase A — JWT (Cogni login / persistent memory) ──────────────────────────
# في production: لا تبقَ على القيمة الافتراضية؛ 32+ حرف عشوائي على الأقل.
JWT_SECRET=change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200
# POST /api/v1/assessment/* (forensic-grade, extract-text, check_plagiarism, stream) يتطلبون
# رأس Authorization: Bearer <JWT من تسجيل الدخول> — نفس المفتاح أعلاه.

# ── Azure Speech (TTS) — فقط عند TTS_AZURE_ONLY=true؛ الإعداد الافتراضي الحالي: Edge TTS. ─
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# TTS_AZURE_ONLY=true
# TTS_DISABLE_NON_AZURE_FALLBACK=true
# TTS_PRIMARY_PROVIDER=azure
# TTS_FORCE_FALLBACK=false
# Local pytest / dev without Azure: TTS_AZURE_ONLY=false
# COGNI_BTEC_REDIS_TTL_SEC=1209600      # TTL لمفاتيح Redis btec:* (افتراضي 14 يوماً)

# ── Phase C — Redis, pools, cost, Stripe ─────────────────────────────────────
# Multi-instance API: use Redis for shared rate limits; set RATE_LIMIT_STRICT_REDIS=true so
# missing Redis returns 503 instead of per-process counters (see app/core/rate_limit.py).
# RATE_LIMIT_STRICT_REDIS=true
REDIS_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
OPENAI_TOKEN_LIMIT_PER_MINUTE=5000
# Redis-backed guard on POST /api/v1/tts* (per client IP). Raise locally if you hit "hourly limit" during dev.
TTS_CALL_LIMIT_PER_HOUR=30
TUTOR_MODEL=gpt-4o
TUTOR_MODEL_FREE=gpt-4o-mini
# العقل الباطن / التخطيط الداخلي (نفس العائلة الافتراضية لـ mini)
THINKER_MODEL=gpt-4o-mini

# OpenAI function-calling (whitelist server tools). Off by default; not used with JSON performance replies.
# COGNI_ENABLE_FUNCTION_TOOLS=true

# Episodic Chroma: max documents per scope; total chars injected into tutor prompt
# COGNI_EPISODIC_MAX_DOCS=80
# COGNI_EPISODIC_PROMPT_CHAR_BUDGET=2400

# BTEC RAG — Docker: LOCAL_RAG_DIR=/app/btec_corpus (compose mounts ./backend/data/btec-bus there)
# Local Windows (absolute): LOCAL_RAG_DIR=E:\Phase 1_ Quantum Foundation Project Setup Instructions\backend\data\btec-bus
# Local `uvicorn` cwd=backend: LOCAL_RAG_DIR=data/btec-bus
LOCAL_RAG_ENABLED=true
LOCAL_RAG_DIR=/app/btec_corpus
#
# Chroma vector corpus for Cogni (separate from LOCAL_RAG): run after adding PDFs under data/btec-bus
#   cd backend && set PYTHONPATH=. && python scripts/btec_ingest.py
# Optional second source tree (e.g. my-backend-project/btec_grader):
#   set BTEC_INGEST_DATA_DIR=E:\...\backend\my-backend-project\btec_grader && python scripts/btec_ingest.py
# BTEC_INGEST_DATA_DIR=
# BTEC_CHROMA_RAG_ENABLED=true
# BTEC_CHROMA_RAG_TOP_K=6
STRIPE_SECRET_KEY=
# في ENVIRONMENT=production: مطلوب لقبول POST /api/v1/webhooks/stripe (رفض 503 بدون سر).
STRIPE_WEBHOOK_SECRET=
SAML_IDP_SSO_URL=

# ── V44 — BTEC tutorial persistence + scaffolding gestures ─────────────────
ENABLE_TUTORIAL_PERSISTENCE=true
COGNI_AUTO_BTEC_SCAFFOLDING=true
COGNI_PEDAGOGICAL_PERFORMANCE=true
COGNI_STAGE_GESTURES=true
# WebSocket /ws/agent: false = require JWT via subprotocol or first {type:auth} frame.
# Production (ENVIRONMENT=production): must be false or the app will refuse to start.
COGNI_WS_ALLOW_ANONYMOUS=false
# /ws/agent: emit speech_start + speech_data + speech_end (split audio out of ``speech``). Set false for legacy single-frame audio.
# COGNI_WS_SPEECH_TIMELINE=true
# Local dev only: skip JWT for POST /api/v1/tts-with-timing (stub user for rate limits) and allow guest /ws/agent.
# Must be false in production (ENVIRONMENT=production) or Settings validation fails.
# COGNI_DEV_BYPASS_AUTH=true
# pytest: opt-in Starlette TestClient tests for /ws/agent (tests/test_voice_pipeline.py).
# COGNI_WS_E2E=1
# Weighted behavior engine (fills WS `behavior` when LLM did not send gestures/gaze/micro). Safe default: off.
# COGNI_BEHAVIOR_ENGINE_ENABLED=true
# COGNI_BEHAVIOR_ENGINE_WHEN=empty
# COGNI_BEHAVIOR_LOGGING=false
# COGNI_BEHAVIOR_LOG_DIR=logs/behavior
# LLM JSON-only avatar: speech/gestures/motor_commands/awareness_cues (see tutor.py _PROFESSOR_COGNI_BUSINESS_JSON_SYSTEM)
# COGNI_PERFORMANCE_JSON_MODE=true
# Dynamic prompt suffix + inferred student state (see app/cogni_brain/)
# ENABLE_EMOTIONAL_INTELLIGENCE=true

# ── BTEC vector RAG backend (app/services/vector_store/) ────────────────────
# chromadb (default) | qdrant (stub only — no retrieval until implemented)
# VECTOR_STORE_TYPE=chromadb
